# Kistly, Frontend-Konfiguration
# Kopiere diese Datei nach .env.local und trage deine Werte ein.
# .env.local wird nicht mit ins Repo aufgenommen.

# Supabase, zu finden unter Project Settings, API
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Oeffentlicher VAPID-Schluessel fuer Push-Benachrichtigungen.
# Erzeugen mit:  node scripts/vapid.mjs
# Der private Schluessel gehoert NICHT hierher, sondern in die
# Supabase Secrets der Edge Function push-send.
VITE_VAPID_PUBLIC_KEY=
